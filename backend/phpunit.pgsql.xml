<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostgreSQL migrations and catalog">
            <file>tests/Feature/PostgresComplaintStatusConstraintsTest.php</file>
            <file>tests/Feature/PostgresFeedbackOwnershipTest.php</file>
            <file>tests/Feature/PostgresQueryIndexesTest.php</file>
        </testsuite>
        <testsuite name="PostgreSQL SQL compatibility">
            <file>tests/Feature/DashboardSummaryTest.php</file>
            <file>tests/Feature/FeedbackMonitoringTest.php</file>
            <file>tests/Feature/StaffReportTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="lgu_complaint_test" force="true"/>
        <env name="DB_USERNAME" value="postgres" force="true"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_SSLMODE" value="disable" force="true"/>
        <env name="FINDING30_POSTGRES_SUITE" value="1" force="true"/>
        <env name="FINDING30_PG_DSN" value="pgsql:host=127.0.0.1;port=5432;dbname=lgu_complaint_test" force="true"/>
        <env name="FINDING30_PG_USER" value="postgres" force="true"/>
        <env name="FINDING30_PG_PASSWORD" value=""/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
    </php>
</phpunit>
